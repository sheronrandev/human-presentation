  "typographic_traps_and_guardrails": {
    "bahnschrift_pdf_bug": {
      "type": "OpenType Variable Weight Collapse",
      "symptom": "Non-Regular weights (Semibold, Bold, Light) collapse back to Bahnschrift Regular upon Microsoft PowerPoint PDF export.",
      "enforcement_rule": "Exclude Bahnschrift from PDF-bound decks; substitute Franklin Gothic Medium, News Gothic MT, or Avenir Next LT Pro."
    },
    "baskerville_old_face_limitation": {
      "type": "Missing Font Styles",
      "symptom": "Ships only as a single Regular weight without genuine Bold or Bold Italic, producing synthetic artificial slant/thickening in Office.",
      "enforcement_rule": "Reserve Baskerville Old Face strictly for display titles without bold tags; substitute Bookman Old Style or Georgia where bold emphasis is required."
    },
    "bell_mt_limitation": {
      "type": "Missing Bold Italic Style",
      "symptom": "Lacks native Bold Italic style.",
      "enforcement_rule": "Substitute Palatino Linotype or Georgia for multi-weight editorial prose."
    },
    "ooxml_embedding_schema_constraints": {
      "child_variant_order": "Child elements in <p:embeddedFont> must strictly follow regular -> bold -> italic -> boldItalic; omit absent styles without blank tags.",
      "parent_sequence_position": "<p:embeddedFontLst> must precede <p:defaultTextStyle> inside <p:presentation>.",
      "mandatory_attributes": "<p:font> declaration requires pitchFamily=\"2\" charset=\"0\".",
      "name_table_match": "XML typeface attribute must match font binary OpenType name table (nameID=\"1\") verbatim.",
      "fstype_licensing_gate": "0 = Installable, 8 = Editable; reject 2 = Restricted License; flag 4 = Preview & Print read-only warning."
    }
  }
